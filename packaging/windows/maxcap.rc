// Windows resources for maxcap.exe: the app icon (ordinal 1, also used for the
// window/taskbar icon in main.rs) and version info shown in Explorer / Task Manager.
// VER_STR and VER_NUM come from Cargo.toml via build.rs.
#include <winver.h>

1 ICON "assets/icon/maxcap.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VER_NUM
PRODUCTVERSION VER_NUM
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "MaxCap"
            VALUE "ProductName", "MaxCap"
            VALUE "FileVersion", VER_STR
            VALUE "ProductVersion", VER_STR
            VALUE "OriginalFilename", "maxcap.exe"
            VALUE "LegalCopyright", "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
